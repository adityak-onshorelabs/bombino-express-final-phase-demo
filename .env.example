# Replace with a real Postgres URL — the template hostname "host" will fail with getaddrinfo ENOTFOUND
DATABASE_URL=postgresql://user:pass@YOUR-DB-HOST/dbname?sslmode=require
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Supabase: IPv4 is preferred by default for *.supabase.co (fixes getaddrinfo ENOTFOUND for logged-in sessions). Set PG_USE_IPV4=0 to disable.
# If TLS to Postgres fails with "self-signed certificate in certificate chain" (corporate proxy / inspection), set PG_SSL_ALLOW_UNSAFE=1 for local dev only. Omit in production if not needed.
# PG_USE_IPV4=0
# PG_SSL_ALLOW_UNSAFE=1
SESSION_SECRET=change-me
# Optional — enables Redis session store and postal lookup cache
REDIS_URL=redis://localhost:6379
ITD_COMPANY_ID=
ITD_EMAIL=
ITD_PASSWORD=
ITD_CUSTOMER_CODE=
ITD_API_COMPANY_ID=
ITD_COOKIE=
OPENAI_API_KEY=
# Absolute base URL of this server — used to construct KYC document file_path URLs for ITD
PUBLIC_URL=https://your-app.railway.app
# Bombino's UPI collection address. Drives the QR an agent shows at the door.
# Leave blank to hide the QR entirely — agents then take the transfer manually,
# which is the behaviour before this was added. Must be the COMPANY's VPA:
# money scanned here is Bombino's revenue, not the agent's.
BOMBINO_UPI_VPA=
# Payee name shown inside the customer's UPI app. Defaults to "Bombino Express".
BOMBINO_UPI_NAME=
