# Replace with a real Postgres URL — the template hostname "host" will fail with getaddrinfo ENOTFOUND
DATABASE_URL=postgresql://user:pass@YOUR-DB-HOST/dbname?sslmode=require
# Supabase: IPv4 is preferred by default for *.supabase.co (fixes getaddrinfo ENOTFOUND for logged-in sessions). Set PG_USE_IPV4=0 to disable.
# If TLS to Postgres fails with "self-signed certificate in certificate chain" (corporate proxy / inspection), set PG_SSL_ALLOW_UNSAFE=1 for local dev only. Omit in production if not needed.
# PG_USE_IPV4=0
# PG_SSL_ALLOW_UNSAFE=1
SESSION_SECRET=change-me
ITD_COMPANY_ID=
ITD_EMAIL=
ITD_PASSWORD=
ITD_CUSTOMER_CODE=
ITD_API_COMPANY_ID=
ITD_COOKIE=
OPENAI_API_KEY=
# Absolute base URL of this server — used to construct KYC document file_path URLs for ITD
# and the "Create Shipment" deep link sent by BIA on WhatsApp
PUBLIC_URL=https://your-app.railway.app

# ── BIA on WhatsApp (Meta Cloud API) ───────────────────────────────────────────
# All four are required; if any is missing /api/whatsapp/webhook returns 503.
# Any string you choose — must match the "Verify token" in Meta App Dashboard → WhatsApp → Configuration
WHATSAPP_VERIFY_TOKEN=
# Meta App Dashboard → App settings → Basic → App secret (verifies X-Hub-Signature-256)
WHATSAPP_APP_SECRET=
# Permanent system-user access token with whatsapp_business_messaging scope
WHATSAPP_TOKEN=
# Meta App Dashboard → WhatsApp → API Setup → "Phone number ID" (not the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=
