# Replace with a real Postgres URL — the template hostname "host" will fail with getaddrinfo ENOTFOUND
DATABASE_URL=postgresql://user:pass@YOUR-DB-HOST/dbname?sslmode=require
# Supabase: IPv4 is preferred by default for *.supabase.co (fixes getaddrinfo ENOTFOUND for logged-in sessions). Set PG_USE_IPV4=0 to disable.
# If TLS to Postgres fails with "self-signed certificate in certificate chain" (corporate proxy / inspection), set PG_SSL_ALLOW_UNSAFE=1 for local dev only. Omit in production if not needed.
# PG_USE_IPV4=0
# PG_SSL_ALLOW_UNSAFE=1
SESSION_SECRET=change-me
# Redis: enables Redis-backed sessions + WhatsApp BIA history/dedupe/rate-limit.
# Unset → sessions use MemoryStore and WhatsApp caches degrade to no-op (BIA still answers).
# On Railway: add a Redis service, then set REDIS_URL=${{Redis.REDIS_URL}} on this service.
REDIS_URL=
ITD_COMPANY_ID=
ITD_EMAIL=
ITD_PASSWORD=
ITD_CUSTOMER_CODE=
ITD_API_COMPANY_ID=
ITD_COOKIE=
OPENAI_API_KEY=
# Absolute base URL of *this server* — used to construct KYC document file_path
# URLs that ITD fetches back off us. Must be reachable from the internet.
PUBLIC_URL=https://your-app.railway.app
# Customer-facing app origin — every user-visible CTA (e.g. BIA's "Create Shipment"
# button on WhatsApp) is built from this, never from PUBLIC_URL.
# Defaults to https://app.bombinoexp.com; only set to override (e.g. staging).
# APP_URL=https://app.bombinoexp.com

# ── BIA on WhatsApp (Tata Tele Omni) ──────────────────────────────────────────
# Both are required; if either is missing the webhook returns 503.
# Omni panel → Settings → Channels → WhatsApp → Access Token
TATA_WA_TOKEN=
# Random string you generate (`openssl rand -hex 24`). Becomes the last path
# segment of the webhook URL registered in the Omni panel:
#   https://<host>/api/whatsapp/webhook/<TATA_WA_WEBHOOK_SECRET>
# Omni does not sign its webhooks, so this URL is the only proof of origin —
# treat the whole thing as a credential.
TATA_WA_WEBHOOK_SECRET=
# Only set if Tata gives us a non-default API host
# TATA_WA_BASE_URL=https://wb.omni.tatatelebusiness.com
